<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Version>0.1.0-preview.1</Version>
        <PackageId>AbleKit</PackageId>
        <Authors>Bamo16</Authors>
        <!-- AbleKit does not say Ableton, so the title, the description's opening and the tags carry it for NuGet search. -->
        <Title>AbleKit: Ableton Live file formats for .NET</Title>
        <Description>Read and write Ableton Live 12's files from .NET: the warp markers, default clip, transients and waveform in a .asd analysis file, so a stem can arrive in Live already warped, the tags in Live's XMP stores and file index, and the samples your Live sets use, relinked when they move. Unofficial; not affiliated with Ableton.</Description>
        <PackageTags>ableton;ableton-live;live;live12;asd;warp;warp-markers;transients;samples;sample-library;xmp;tags;als;live-set;audio;music-production;daw</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/Bamo16/AbleKit</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Bamo16/AbleKit</RepositoryUrl>
        <!-- A public library: every public member needs a doc comment, and CS1591 fails the build without one. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="AbleKit.Tests" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Data.Sqlite" />
    </ItemGroup>
</Project>
