<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Version>0.1.0-preview.1</Version>
        <PackageId>AbletonSampleData</PackageId>
        <Authors>Bamo16</Authors>
        <Description>Reads what Ableton Live 12 knows about your samples: the warp markers, default clip and transients in a .asd analysis file, and the tags in its XMP stores and file index. Writes analysis files, so a stem arrives in Live already warped. Unofficial.</Description>
        <PackageTags>ableton;ableton-live;asd;warp;xmp;tags;audio</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/Bamo16/AbletonSampleData</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Bamo16/AbletonSampleData</RepositoryUrl>
        <!-- A public library: every public member needs a doc comment, and CS1591 fails the build without one. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="AbletonSampleData.Tests" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Data.Sqlite" />
    </ItemGroup>
</Project>
